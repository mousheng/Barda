{
  "name": "taco-fe",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^14.18.0 || >=16.0.0"
  },
  "scripts": {
    "start": "NODE_OPTIONS=--max-old-space-size=6144 && yarn workspace barda start",
    "start:comps": "yarn workspace barda-comps start",
    "start:dev": "NODE_OPTIONS=--max-old-space-size=6144 && BARDA_API_SERVICE_URL=http://localhost:8080 && yarn workspace barda start",
    "start:ee": "REACT_APP_EDITION=enterprise yarn workspace barda start",
    "start:ee-global": "REACT_APP_EDITION=enterprise-global yarn workspace barda start",
    "build": "yarn node ./scripts/build.js",
    "test": "jest && yarn workspace barda-comps test",
    "test:cov": "jest --coverage",
    "prepare": "yarn workspace barda prepare",
    "build:core": "yarn workspace barda-core build",
    "build:sdk": "yarn workspace barda-sdk build",
    "build:comps": "yarn workspace barda-comps build",
    "test:core": "yarn workspace barda-core test",
    "build:vis": "ENABLE_VISUALIZER=true && yarn node ./scripts/build.js"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-typescript": "^7.18.6",
    "@rollup/plugin-typescript": "^8.5.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^12.0.0",
    "@testing-library/user-event": "^13.2.1",
    "@types/ali-oss": "^6.16.4",
    "@types/file-saver": "^2.0.5",
    "@types/jest": "^29.5.0",
    "@types/mime": "^2.0.3",
    "@types/qrcode.react": "^1.0.2",
    "@types/react-grid-layout": "^1.3.0",
    "@types/react-helmet": "^6.1.5",
    "@types/react-resizable": "3.0.7",
    "@types/react-router-dom": "^5.3.2",
    "@types/shelljs": "^0.8.11",
    "@types/stylis": "^4.2.6",
    "@types/tern": "0.22.0",
    "@types/toposort": "^2.0.3",
    "@types/ua-parser-js": "^0.7.36",
    "@welldone-software/why-did-you-render": "^8",
    "add": "^2.0.6",
    "babel-jest": "^29.3.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "babel-preset-react-app": "^10.0.1",
    "barda-dev-utils": "workspace:^",
    "husky": "^9.0.11",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "lint-staged": "^13.0.1",
    "mq-polyfill": "^1.1.8",
    "prettier": "2.7.0",
    "rimraf": "^3.0.2",
    "rollup": "^4.17.2",
    "shelljs": "^0.8.5",
    "svgo": "^3.0.0",
    "typescript": "^5.4.0",
    "whatwg-fetch": "^3.6.2",
    "yarn": "^1.22.19"
  },
  "lint-staged": {
    "**/*.{mjs,ts,tsx,json,md,html}": "prettier --write --ignore-unknown",
    "**/*.svg": "svgo"
  },
  "packageManager": "yarn@3.2.4",
  "resolutions": {
    "@types/react": "^18",
    "moment": "2.29.2",
    "canvas": "https://registry.yarnpkg.com/@favware/skip-dependency/-/skip-dependency-1.2.1.tgz",
    "react-virtualized@^9.22.3": "patch:react-virtualized@npm%3A9.22.3#./.yarn/patches/react-virtualized-npm-9.22.3-0fff3cbf64.patch",
    "eslint-plugin-only-ascii@^0.0.0": "patch:eslint-plugin-only-ascii@npm%3A0.0.0#./.yarn/patches/eslint-plugin-only-ascii-npm-0.0.0-29e3417685.patch"
  },
  "dependencies": {
    "antd-mobile": "^5.28.0",
    "chalk": "4",
    "number-precision": "^1.6.0",
    "react-player": "^2.11.0",
    "tui-image-editor": "^3.15.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn test",
      "commit-msg": "commitlint -e $HUSKY_GIT_PARAMS"
    }
  }
}
